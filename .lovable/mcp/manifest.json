{
  "version": 1,
  "sdk_version": "3.4.0",
  "path": "/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "bolt-to-lovable",
      "version": "0.1.0",
      "title": "Bolt to Lovable"
    },
    "tools": [
      {
        "name": "list_seasons",
        "title": "List seasons",
        "description": "List the published football seasons (English or Spanish league) with their IDs and match counts.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "league": {
              "description": "League: angol (English) or spanyol (Spanish). Omit for both.",
              "type": "string",
              "enum": [
                "angol",
                "spanyol"
              ]
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "get_season_matches",
        "title": "Get season matches",
        "description": "Return the match results of one season. Get season IDs from list_seasons.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "seasonId": {
              "type": "string",
              "minLength": 1,
              "description": "Season ID from list_seasons."
            }
          },
          "required": [
            "seasonId"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "get_team_ratings",
        "title": "Get team ratings",
        "description": "Return the current team strength ratings computed by the WinMix engine for a league.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "league": {
              "type": "string",
              "enum": [
                "angol",
                "spanyol"
              ],
              "description": "League: angol (English) or spanyol (Spanish)."
            }
          },
          "required": [
            "league"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      }
    ]
  }
}
